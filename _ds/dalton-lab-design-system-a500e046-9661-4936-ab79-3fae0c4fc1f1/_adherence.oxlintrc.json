      "--mono": "font",
      "--cyan": "color",
      "--cyan-bright": "color",
      "--cyan-deep": "color",
      "--purple": "color",
      "--purple-deep": "color",
      "--cyan-faint": "color",
      "--cyan-glow": "color",
      "--purple-glow": "color",
      "--bg-0": "color",
